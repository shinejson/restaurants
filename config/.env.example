# ---------------------------------------------------------------------------
# RestaurantOS — SaaS platform configuration
# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=local
APP_DEBUG=true
APP_NAME="RestaurantOS"
APP_TIMEZONE=UTC

# Public root of the platform (used for links in emails and redirects).
APP_ROOT_DOMAIN=restaurantos.test
APP_SCHEME=http

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# driver: mysql  => production, one MySQL database per tenant
#         sqlite => zero-setup demo / sandbox, one SQLite file per tenant
DB_DRIVER=sqlite

# Control-plane (platform) database — tenants, plans, subscriptions, invoices…
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_NAME=restaurantos_platform
PLATFORM_DB_USER=restaurantos
PLATFORM_DB_PASS=

# SQLite only: where per-tenant + platform files live.
DB_SQLITE_PATH=storage

# Tenant databases (mysql driver): "db-per-tenant" creates restaurantos_t_<slug>
TENANT_DB_PREFIX=restaurantos_t_
# MySQL credentials used to provision tenant databases.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USER=restaurantos
TENANT_DB_PASS=

# ---------------------------------------------------------------------------
# Platform behaviour
# ---------------------------------------------------------------------------
# Trials get this many days by default (plans may override).
DEFAULT_TRIAL_DAYS=14
# Requests per minute per IP for the public API login endpoints.
API_RATE_LIMIT=60
# Allow the console to create tenants with the same DB user (no CREATE DATABASE).
TENANT_AUTO_PROVISION=true
# Show the seeded demo tenant when a request does not resolve a tenant.
DEMO_TENANT_SLUG=demo
