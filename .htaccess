# RestaurantOS — Apache front controller.
#
# The dev server (tools/dev-server.mjs) applies the equivalent rules in
# tools/php-runtime.mjs, so this file matters for real deployments only.
#
# Declare UTF-8 on every static response so browsers don't sniff/decode
# UTF-8 bytes as Latin-1 (which mangles em-dashes, accented names and the
# emoji in tenant branding into mojibake that looks like a foreign language).
# PHP responses already carry charset=utf-8 via php.ini's default_charset.
AddDefaultCharset UTF-8
# AddDefaultCharset doesn't always apply to text/javascript, so be explicit:
AddCharset UTF-8 .js .mjs .css .json .svg .xml .map

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Public JSON API consumed by the superadmin console and integrations.
    RewriteRule ^api/(.*)$ platform/api/index.php [QSA,L]

    # -------------------------------------------------------------------------
    # Unique platform routing per tenant: /t/<slug-or-code>/...
    # -------------------------------------------------------------------------
    # Static assets requests relative to /t/<tenant>/
    RewriteRule ^t/[^/]+/assets/(.*)$ assets/$1 [L]
    RewriteRule ^t/[^/]+/img/(.*)$ img/$1 [L]

    # Admin access routes
    RewriteRule ^t/([a-zA-Z0-9_-]+)/admin/login\.php/?$ admin/login.php?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/admin/?$ admin/login.php?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/admin/(.+)$ admin/$2?__tenant=$1 [QSA,L]

    # Auth, AJAX, Orders, Profile
    RewriteRule ^t/([a-zA-Z0-9_-]+)/auth/(.+)$ auth/$2?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/ajax/(.+)$ ajax/$2?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/orders/(.+)$ orders/$2?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/profile/(.+)$ profile/$2?__tenant=$1 [QSA,L]

    # Storefront pages under /t/<tenant>/
    RewriteRule ^t/([a-zA-Z0-9_-]+)/?$ index.php?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/(index|menu|about|contact|events|event_booking|cart|checkout|orders|profile|customer_order|order-confirmation)/?$ $2.php?__tenant=$1 [QSA,L]
    RewriteRule ^t/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+\.php)$ $2?__tenant=$1 [QSA,L]

    # Pretty URLs for the default storefront.
    RewriteRule ^(index|menu|about|contact|events|event_booking|cart|checkout|orders)/?$ $1.php [QSA,L]

    # Sub-directory installs (e.g. https://host/restaurants/…) keep working:
    # BASE_URL is derived from the script path, so no extra rule is needed.
</IfModule>

# Never serve private state through the web root.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sqlite|sqlite3|db|env|log)$">
        Require all denied
    </FilesMatch>
</IfModule>

<Files "composer.json">
    Require all denied
</Files>

# storage/ holds tenant databases, sessions and uploads.
RedirectMatch 404 ^/storage/
